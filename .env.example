# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
#
# ---------------------------------------------------------------------------
# BROKER — works for BOTH local Redpanda and Confluent Cloud.
# ---------------------------------------------------------------------------
#
# Local Redpanda (docker compose up):
#   KAFKA_BOOTSTRAP_SERVERS=localhost:19092
#   KAFKA_SECURITY_PROTOCOL=PLAINTEXT
#   KAFKA_SASL_MECHANISM=
#   KAFKA_SASL_USERNAME=
#   KAFKA_SASL_PASSWORD=
#
# Confluent Cloud (from the cluster's API key page):
#   KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=PLAIN
#   KAFKA_SASL_USERNAME=<CONFLUENT_API_KEY>
#   KAFKA_SASL_PASSWORD=<CONFLUENT_API_SECRET>

KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# TOPICS
# ---------------------------------------------------------------------------
TOPIC_EDITS=wiki.edits
TOPIC_METRICS=wiki.metrics

# ---------------------------------------------------------------------------
# PIPELINE TUNING
# ---------------------------------------------------------------------------
WINDOW_SECONDS=60          # tumbling window size
SPIKE_BASELINE_WINDOWS=15  # trailing windows used for the rolling mean/stddev
SPIKE_K=3.0                # flag when count > mean + K * stddev
SPIKE_MIN_COUNT=10         # ignore low-volume wikis (need at least this many edits)

# ---------------------------------------------------------------------------
# SINK — MotherDuck (cloud) or local DuckDB file.
# ---------------------------------------------------------------------------
# Local file:   DUCKDB_DATABASE=wikipulse.duckdb
# MotherDuck:   DUCKDB_DATABASE=md:wikipulse    (also set MOTHERDUCK_TOKEN)
DUCKDB_DATABASE=wikipulse.duckdb
MOTHERDUCK_TOKEN=
