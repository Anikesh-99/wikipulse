# Streamlit Community Cloud secrets.
#
# LOCAL: copy this file to `.streamlit/secrets.toml` (gitignored) to test the
#        hosted config on your machine. Not required for normal local runs,
#        which read `.env` instead.
#
# HOSTED: do NOT commit real secrets. Paste these same keys into the Streamlit
#         Community Cloud app under  Settings -> Secrets  (same TOML format).

# Point the dashboard at MotherDuck so it can read data written by your local
# sink. Both sides must use the same database name.
DUCKDB_DATABASE = "md:wikipulse"
MOTHERDUCK_TOKEN = "paste-your-motherduck-access-token"

# Optional display tuning (defaults are fine).
WINDOW_SECONDS = "60"
SPIKE_K = "3.0"
